{
  "name": "mcp-everything",
  "version": "0.5.2",
  "description": "An MCP server that turns any open source project on GitHub or GitLab into a sandboxed, dynamically generated toolset.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msieurthenardier/mcp-everything.git"
  },
  "bin": {
    "mcp-everything": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --project default",
    "test:slow": "vitest run --project slow",
    "test:docker": "MCPE_DOCKER_TESTS=1 vitest run --reporter=verbose test/integration",
    "test:docker:pressure": "MCPE_DOCKER_TESTS=1 MCPE_PRESSURE_TESTS=1 vitest run --reporter=verbose test/integration -t 'under fork pressure'"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "semver": "^7.8.6",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
